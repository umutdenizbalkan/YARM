@@ -7,10 +7,11 @@
 #
 # One clean boot with `yarm.futex_requeue_witness=1`, kernel and init both built with
 # `futex-wait-witness`: init's selector-18 cell then runs the wait witness instead of FUTEX-REQUEUE1's
-# rounds. A waiter thread issues FutexWait(WORD, v) for 16 cycles, each v read just before; a
-# signaller thread on the other CPU issues FutexWake(WORD, 1) in a loop, storing a new value first
-# on even cycles. The kernel holds each witness wait open before its compare-and-register (B) and
-# after it (A), each until a wake from the other CPU has run inside.
+# rounds. A waiter thread issues FutexWait(WORD, v) for 16 cycles, each v read just before; two
+# signaller threads issue FutexWake(WORD, 1) in a loop, storing a new value first on even cycles,
+# while init blocks. The kernel holds each witness wait open before its compare-and-register (B)
+# and after it (A), each until a wake from another CPU has run inside — but only while a sibling of
+# the waiter is current on another CPU (otherwise the wait is logged SKIPPED and runs unwindowed).
 #
 # The verdict comes from scripts/grade-futex-wait-witness.py (its docstring has the rules), plus
 # the standard core smoke. Raw serial log, normalized log and grader output are kept in $LOGDIR.
diff --git a/src/kernel/boot/futex.rs b/src/kernel/boot/futex.rs
index 7dcaef58..52abd58c 100644
--- a/src/kernel/boot/futex.rs
+++ b/src/kernel/boot/futex.rs
@@ -1220,6 +1220,8 @@ pub mod race_witness {
 /// `..._IN_WINDOW_WAKE` before it releases it, `..._WINDOW_CLOSE` after (B's close also reports the
 /// word it reads then, so a grader can tell whether the window saw a store). `..._RESULT` is the
 /// wait's own outcome. Bounded: a window gives up after `SPIN_BOUND` polls (`competing_wakes=0`).
+/// A wait opens its windows only while a sibling thread of the waiter (same address space, another
+/// TID) is current on another CPU; otherwise it is logged `..._SKIPPED` and runs unwindowed.
 #[cfg(feature = "futex-wait-witness")]
 pub mod wait_witness {
     use core::sync::atomic::{AtomicU64, Ordering::SeqCst};
@@ -1246,6 +1248,17 @@ pub mod wait_witness {
         })
     }
 
+    /// A witness wait that opens no window: no sibling thread of the waiter is current on another
+    /// CPU, so no competing wake could arrive (a window held then would only spin to its bound).
+    pub fn skip(wait: u64, cpu: u8, tid: u64) {
+        crate::yarm_log!(
+            "FUTEX_WAIT_WITNESS_SKIPPED wait={} cpu={} tid={} reason=no_peer_running",
+            wait,
+            cpu,
+            tid
+        );
+    }
+
     /// The witness wait the park transaction just ran, for the route's outcome line.
     pub fn current_wait(expected: u32) -> Option<u64> {
         armed(expected).then(|| LAST_WAIT.load(SeqCst))
