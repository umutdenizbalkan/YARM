+                // After it: on object 2, untouched by either wake.
+                (Res::Wait(true), vec![0, 0], true, false),
+            ];
+            assert!(
+                admitted.contains(&observed),
+                "NOT LINEARIZABLE: {observed:?}, admitted {admitted:?}"
+            );
+        }
