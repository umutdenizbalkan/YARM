+            for i in 0..60u32 {
+                k.with(|s| {
+                    if s.task_status(d) != Some(TaskStatus::Running) {
+                        run(s, d);
+                    }
+                });
+                match i % 4 {
+                    0 => fx::futex_phase_hook::arm_after_register(alloc::boxed::Box::new(
