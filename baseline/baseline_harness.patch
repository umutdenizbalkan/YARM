+        /// 11 / 16 / 21 — a blocking SEND's completion is its own exact record, consumed once, and
+        /// the park commit neither creates nor consumes one. A record of another cycle is refused.
+        #[test]
+        fn t11_a_send_completion_is_exact_and_consumed_once() {
+            clear_cells();
+            let w = world(54000);
+            let (a, t) = (w.a, w.driver);
+            let k = leak(w.s);
+            let record = |generation: u64| BlockedSyscallCompletion {
+                syscall_class: BlockedSyscallClass::IpcSend,
+                result: 0,
+                tid: t,
+                asid: a,
+                blocked_generation: generation,
+            };
+            let live = k
+                .with(|s| s.with_tcb_mut(t, |tcb| tcb.blocked_send_generation))
+                .expect("tcb");
+            // A record of an older cycle is not this send's.
+            k.with(|s| {
+                s.with_tcb_mut(t, |tcb| {
+                    tcb.pending_syscall_completion = Some(record(live.wrapping_sub(1)))
+                })
+            });
