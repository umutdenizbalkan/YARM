+                k.with(
+                    |s| s.take_blocked_syscall_completion_of_class(t, BlockedSyscallClass::IpcSend)
+                )
+                .is_none()
+            );
+            k.with(|s| {
+                s.with_tcb_mut(t, |tcb| tcb.pending_syscall_completion = Some(record(live)))
+            });
