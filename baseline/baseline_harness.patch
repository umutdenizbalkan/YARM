+            clear_cells();
+            assert!(
+                k.with(|s| s.has_pending_syscall_completion(t)),
+                "still parked"
+            );
+            let once = k.with(|s| {
+                s.take_blocked_syscall_completion_of_class(t, BlockedSyscallClass::IpcSend)
+            });
