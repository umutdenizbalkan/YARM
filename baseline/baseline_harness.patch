diff --git a/src/kernel/boot/tests.rs b/src/kernel/boot/tests.rs
index 7e46b37c..092e472b 100644
--- a/src/kernel/boot/tests.rs
+++ b/src/kernel/boot/tests.rs
@@ -214700,6 +214700,854 @@ mod futex_requeue1 {
     /// other CPUs' operations run to completion; every observed history is checked against the
     /// sequential specification of `atomic1`. The wait is the floating operation: the others run
     /// in this order, all of them inside the wait's interval.
+    /// RISCV-PARK-RET1 — a RISC-V syscall continuation resumes with ITS OWN result.
+    ///
+    /// The chain each test walks is the production one wherever the code is hosted: the split
+    /// FutexWait park transaction, the wake, requeue and exit owners, the deferral cells, the
+    /// RISC-V commit (`riscv_commit_final_park_result`), the outgoing capture
+    /// (`capture_outgoing_user_context_split`), the TCB store and `TrapFrame::apply_user_context`.
+    /// Three pieces are RISC-V-only code with no hosted build, and are modelled here exactly: the
+    /// route's `Parked` answer (`set_ok(1, 0, 0)`), the bridge write-back's ABI arms
+    /// (`src/arch/riscv64/boot.rs`) and the user runtime's decode (`yarm-user-rt`). Each model is
+    /// pinned to its source by `g01`–`g05`, so a change to the real code fails a guard here.
+    ///
+    /// "Ring 3" below is the register file the `sret` installs — what the instruction after the
+    /// `ecall` observes — and the user runtime's verdict on it.
+    mod riscv_park_ret1 {
+        use super::wait_atomic1::wait;
+        use super::*;
+        use crate::kernel::boot as kb;
+        use crate::kernel::syscall::{SYSCALL_FUTEX_WAIT_NR, SYSCALL_YIELD_NR, SyscallError};
+        use crate::kernel::task::{
+            BlockedSyscallClass, BlockedSyscallCompletion, UserRegisterContext,
+        };
+        use crate::kernel::trapframe::TrapFrame;
+
+        /// The `ecall` instruction; the bridge pre-advances `sepc` past it once, at entry.
+        const ECALL: usize = 0x40_1000;
+        const USER_SP: usize = 0x7fbf_f7b0;
+        /// Registers no syscall return may touch: `ra`, `tp`, `t0`, `s0`, `a6`.
+        const KEEP: [(usize, usize); 5] = [
+            (1, 0x1111),
+            (4, 0x4444),
+            (5, 0x5555),
+            (8, 0x8888),
+            (16, 0x6666),
+        ];
+
+        /// What the RISC-V bridge imports for an `ecall` with `nr` in `a7` and `args` in `a0..a5`:
+        /// the argument lanes, the register file (`x1..x31`, the ABI block included), `sepc + 4`.
+        fn ecall(nr: usize, args: [usize; 6]) -> TrapFrame {
+            let mut f = TrapFrame::new(nr, args);
+            for (i, v) in args.iter().enumerate() {
+                f.set_user_gpr(10 + i, *v);
+            }
+            f.set_user_gpr(17, nr);
+            f.set_user_gpr(2, USER_SP);
+            for (r, v) in KEEP {
+                f.set_user_gpr(r, v);
+            }
+            f.set_saved_pc(ECALL + 4);
+            f.set_saved_sp(USER_SP);
+            f
+        }
+
+        /// The register file the `sret` installs.
+        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+        struct Ring3 {
+            a: [usize; 8],
+            sepc: usize,
+            sp: usize,
+            keep: [usize; 5],
+        }
+        impl Ring3 {
+            fn of(a: [usize; 8], sepc: usize, sp: usize, gprs: &[usize; 32]) -> Self {
+                Ring3 {
+                    a,
+                    sepc,
+                    sp,
+                    keep: KEEP.map(|(r, _)| gprs[r]),
+                }
+            }
+            /// `yarm-user-rt::futex_wait` on this port (pinned by `g03`).
+            fn futex_wait(&self) -> Result<bool, usize> {
+                if self.a[0] > 1 {
+                    Err(self.a[0])
+                } else {
+                    Ok(self.a[0] != 0)
+                }
+            }
+            /// `yarm-user-rt::yield_now` on this port.
+            fn yield_now(&self) -> Result<(), usize> {
+                if self.a[0] != 0 {
+                    Err(self.a[0])
+                } else {
+                    Ok(())
+                }
+            }
+        }
+
+        /// The write-back's SWITCHED ordinary arm (`boot.rs`: no async tag, no continuation tag):
+        /// the incoming context is applied to this trap's frame, `a0..a5` come from its argument
+        /// lanes, `a7` is zeroed, every other register is mirrored from its register file.
+        fn switched(this_trap: &TrapFrame, ctx: UserRegisterContext) -> Ring3 {
+            let mut f = this_trap.clone();
+            f.apply_user_context(ctx);
+            let a = [
+                f.arg(0),
+                f.arg(1),
+                f.arg(2),
+                f.arg(3),
+                f.arg(4),
+                f.arg(5),
+                f.user_gpr(16),
+                0,
+            ];
+            Ring3::of(a, f.saved_pc(), f.saved_sp(), &f.user_gprs)
+        }
+
+        /// The write-back's SWITCHED continuation arm (a consumer published the tag): the result
+        /// lanes of the frame, `a3` = the error, `a4`, `a5`, `a7` from the register file.
+        fn switched_continuation(f: &TrapFrame) -> Ring3 {
+            let (a0, a1, a2, a3) = match f.error_code() {
+                Some(e) => (e, 0, 0, e),
+                None => (f.ret0(), f.ret1(), f.ret2(), 0),
+            };
+            let a = [
+                a0,
+                a1,
+                a2,
+                a3,
+                f.user_gpr(14),
+                f.user_gpr(15),
+                f.user_gpr(16),
+                f.user_gpr(17),
+            ];
+            Ring3::of(a, f.saved_pc(), f.saved_sp(), &f.user_gprs)
+        }
+
+        /// The write-back's SAME-TASK arm for the trap `entered`: when an exact-token drain applied
+        /// the caller's own saved continuation (`self_resume`), the published lanes are adopted;
+        /// then `a0..a3` from the result, and `a4`, `a5`, `a7` are the hardware frame's.
+        fn same_task(entered: &TrapFrame, self_resume: Option<UserRegisterContext>) -> Ring3 {
+            let mut f = entered.clone();
+            if let Some(ctx) = self_resume {
+                f.apply_user_context(ctx);
+                f.adopt_restored_riscv_syscall_returns();
+            }
+            let (a0, a1, a2, a3) = match f.error_code() {
+                Some(e) => (e, 0, 0, e),
+                None => (f.ret0(), f.ret1(), f.ret2(), 0),
+            };
+            let hw = entered.user_gprs;
+            let a = [a0, a1, a2, a3, hw[14], hw[15], hw[16], hw[17]];
+            Ring3::of(a, f.saved_pc(), f.saved_sp(), &f.user_gprs)
+        }
+
+        /// The write-back's ASYNC arm: the whole register file, verbatim.
+        fn async_resume(this_trap: &TrapFrame, ctx: UserRegisterContext) -> Ring3 {
+            let mut f = this_trap.clone();
+            f.apply_user_context(ctx);
+            let g = f.user_gprs;
+            Ring3::of(
+                [g[10], g[11], g[12], g[13], g[14], g[15], g[16], g[17]],
+                f.saved_pc(),
+                f.saved_sp(),
+                &g,
+            )
+        }
+
+        fn saved(k: &SharedKernel, t: u64) -> UserRegisterContext {
+            k.with(|s| s.with_tcb_mut(t, |tcb| tcb.user_context))
+                .expect("tcb")
+        }
+
+        fn clear_cells() {
+            kb::futex_wait_dispatch_clear(0);
+            kb::d2_recv_dispatch_clear(0);
+            kb::yield_dispatch_clear(0);
+        }
+
+        /// The RISC-V bridge's committed-park arm, in the bridge's order (pinned by `g05`): the
+        /// outgoing from the deferral chain, the exit check, the commit, the capture, and the
+        /// receive re-application.
+        fn bridge(k: &SharedKernel, f: &mut TrapFrame) -> (bool, bool) {
+            let futex_wait_outgoing = kb::futex_wait_dispatch_outgoing(0);
+            let outgoing = futex_wait_outgoing
+                .or_else(|| kb::d2_recv_dispatch_outgoing(0))
+                .or_else(|| kb::yield_dispatch_outgoing(0));
+            let exiting =
+                kb::exit_queue_advance_pending(0).is_some_and(|(et, _)| Some(et) == outgoing);
+            let committed = kb::riscv_commit_final_park_result(0, f);
+            let captured = if exiting {
+                false
+            } else {
+                outgoing
+                    .map(|t| k.capture_outgoing_user_context_split(t, f))
+                    .unwrap_or(false)
+            };
+            if captured
+                && futex_wait_outgoing.is_none()
+                && let Some(t) = outgoing
+                && kb::d2_recv_dispatch_outgoing(0) == Some(t)
+            {
+                k.reapply_parked_recv_completion_split(t);
+            }
+            (committed, captured)
+        }
+
+        /// A GENUINE park: the split transaction parks `t` (it leaves CPU 0), the route answers
+        /// `Parked` with `set_ok(1, 0, 0)`, its deferral names `t`, and the bridge commits and
+        /// captures. Returns the trap's frame.
+        fn park(k: &SharedKernel, a: Asid, t: u64, va: usize, exp: u32) -> TrapFrame {
+            clear_cells();
+            let mut f = ecall(SYSCALL_FUTEX_WAIT_NR, [va, exp as usize, 0, 0, 0, 0]);
+            let (_r, o) = wait(k, a, t, va, exp, P);
+            assert!(matches!(o, FutexParkOutcome::Parked { .. }), "{t}: {o:?}");
+            f.set_ok(1, 0, 0);
+            assert!(kb::futex_wait_dispatch_try_defer(0, t));
+            assert!(bridge(k, &mut f).1, "captured");
+            clear_cells();
+            f
+        }
+
+        /// The signaller's own trap on the waiter's home CPU, whose drain switches to the waiter.
+        fn other_trap() -> TrapFrame {
+            ecall(SYSCALL_YIELD_NR, [0; 6])
+        }
+
+        fn assert_resumed_with(r: &Ring3, a0: usize) {
+            assert_eq!(
+                (r.a[0], r.a[1], r.a[2]),
+                (a0, 0, 0),
+                "the result lanes: {r:?}"
+            );
+            assert_eq!(
+                (r.a[3], r.a[4], r.a[5]),
+                (0, 0, 0),
+                "a3..a5 as the caller left them"
+            );
+            assert_eq!(r.sepc, ECALL + 4, "exactly once past the ecall");
+            assert_eq!(r.sp, USER_SP);
+            assert_eq!(r.keep, KEEP.map(|(_, v)| v), "ra, tp, t0, s0, a6 untouched");
+        }
+
+        /// 1 — a wake between the registration and the compare-and-clear: the wait never leaves
+        /// the CPU and returns through its own frame, `1`, with nothing committed or captured.
+        #[test]
+        fn t01_a_wait_woken_before_it_leaves_the_cpu_returns_through_its_own_frame() {
+            clear_cells();
+            let w = world(52000);
+            let (a, t) = (w.a, 52100);
+            let k = leak(w.s);
+            fx::futex_phase_hook::arm_after_register(alloc::boxed::Box::new(move || {
+                assert_eq!(
+                    k.futex_wake_split_mut(CpuId(1), a, SQ, 1, P).expect("wake"),
+                    1
+                );
+            }));
+            let mut f = ecall(SYSCALL_FUTEX_WAIT_NR, [SQ, 5, 0, 0, 0, 0]);
+            let (_r, o) = wait(k, a, t, SQ, 5, P);
+            assert!(matches!(o, FutexParkOutcome::WokenDuringPublication { .. }));
+            f.set_ok(1, 0, 0);
+            let r = same_task(&f, None);
+            assert_resumed_with(&r, 1);
+            assert_eq!(r.a[7], SYSCALL_FUTEX_WAIT_NR, "a7 is the hardware frame's");
+            assert_eq!(r.futex_wait(), Ok(true));
+        }
+
+        /// 2 — THE CASE: the caller genuinely parks, another CPU wakes it, its home CPU switches
