"""KERNEL-NOFP1-ACCEPTANCE — a disassembler stand-in for the checker's malformed-output fixtures.

Runs the real `objdump` (`YARM_NOFP_STUB_REAL`, the one the checker resolved) and rewrites its
output the way `YARM_NOFP_STUB` names, so a fixture can present decoder output the checker must
refuse to interpret. `passthrough` changes nothing (the control). The output modes touch only the
first ordinary integer instruction of the fixture's `kernel_main` (`mov %rax,%rbx`); the tool modes
report an unsupported version or garble the checker's own probe decoding.
"""
import os
import re
import subprocess
import sys

real = os.environ.get("YARM_NOFP_STUB_REAL")
if not real or not os.access(real, os.X_OK):
    sys.exit("stub objdump: YARM_NOFP_STUB_REAL does not name the real objdump")
mode = os.environ.get("YARM_NOFP_STUB", "passthrough")
if mode == "fails" and "--version" not in sys.argv:
    sys.stderr.write("objdump: simulated failure\n")
    sys.exit(1)
if mode == "old-version" and "--version" in sys.argv:
    print("GNU objdump (GNU Binutils) 2.38")
    sys.exit(0)
r = subprocess.run([real] + sys.argv[1:], capture_output=True, text=True)
out = r.stdout
if mode == "garble-probe" and "nofp-probe-" in " ".join(sys.argv):
    out = out.replace("rex.WB fninit", "fninit")
target = re.compile(r"^(\s*[0-9a-f]+:\s+48 89 c3\s+)(mov\s+%rax,%rbx)$", re.M)
if mode == "unknown-prefix":
    out = target.sub(r"\1rex.Q \2", out, count=1)
elif mode == "extra-tokens":
    out = target.sub(r"\1\2 extra", out, count=1)
elif mode == "bad-pseudo-prefix":
    out = target.sub(r"\1{bad} \2", out, count=1)
elif mode == "garbage-line":
    out = target.sub(r"\1\2\n  ?? garbage ??", out, count=1)
elif mode == "dropped-line":
    out = target.sub("", out, count=1)
elif mode not in ("passthrough", "fails", "old-version", "garble-probe"):
    sys.exit(f"stub objdump: unknown mode {mode}")
sys.stdout.write(out)
sys.stderr.write(r.stderr)
sys.exit(r.returncode)
